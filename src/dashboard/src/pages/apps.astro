---
import Base from '../layouts/Base.astro';
import { apps } from '../data/apps';
const label: Record<string, string> = {
  runs: 'Runs as committed',
  'needs-setup': 'Needs setup',
  'byo-keys': 'Bring your own keys',
};
---
<Base title="Apps" description="Runnable projects from the coursework, with the command that starts each one.">
  <div class="mx-auto max-w-4xl px-4 sm:px-6 py-20">
    <p class="eyebrow settle">{apps.length} projects</p>
    <h1 class="display text-[clamp(2.25rem,5.5vw,3.5rem)] mt-4 settle" style="animation-delay: 100ms">Run it yourself.</h1>
    <p class="mt-6 max-w-xl text-lg leading-relaxed settle" style="animation-delay: 180ms; color: var(--muted)">
      Every project below runs from source, and each command is the one I actually use to
      start it. Where something needs your own credentials, it says so.
    </p>

    <ul class="mt-16 space-y-5">
      {apps.map((a, i) => (
        <li class="reveal p-7 rounded-2xl border lift" style={`border-color: var(--line); background: var(--surface); transition-delay: ${i * 40}ms`}>
          <div class="flex flex-wrap items-baseline gap-x-4 gap-y-2">
            <h2 class="display text-2xl" style="font-variation-settings: 'SOFT' 50, 'WONK' 1, 'opsz' 28">{a.name}</h2>
            <span class="eyebrow">{a.course}</span>
            <span class="ml-auto text-[11px] px-2.5 py-1 rounded-full border"
                  style={a.status === 'runs'
                    ? 'border-color: var(--patina); color: var(--patina)'
                    : 'border-color: var(--line); color: var(--muted)'}>{label[a.status]}</span>
          </div>

          <p class="mt-3 leading-relaxed max-w-2xl" style="color: var(--muted)">{a.blurb}</p>

          <ul class="mt-4 flex flex-wrap gap-1.5">
            {a.stack.map((s) => (
              <li class="text-[11px] font-mono px-2 py-0.5 rounded-full" style="background: var(--patina-soft); color: var(--patina)">{s}</li>
            ))}
          </ul>

          <pre class="mt-5 p-4 rounded-xl overflow-x-auto text-[13px] leading-relaxed border" style="border-color: var(--line); background: var(--paper)"><code class="font-mono">{a.run.join('\n')}</code></pre>

          {a.note && <p class="mt-3 text-sm" style="color: var(--muted)"><strong style="color: var(--ink)">Note.</strong> {a.note}</p>}
          {a.live && <a href={a.live} class="mt-3 inline-block text-sm hover:underline" style="color: var(--patina)">Live repository →</a>}
        </li>
      ))}
    </ul>
  </div>
</Base>
