---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { href } from '../../lib/site';

const pages = (await getCollection('wiki')).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Wiki" description="Notes on how the projects work, and what it took to make them run.">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 py-20">
    <p class="eyebrow settle">{pages.length} notes</p>
    <h1 class="display text-[clamp(2.25rem,5.5vw,3.5rem)] mt-4 settle" style="animation-delay: 100ms">Wiki.</h1>
    <p class="mt-6 max-w-xl text-lg leading-relaxed settle" style="animation-delay: 180ms; color: var(--muted)">
      How things are built, what broke on the way, and the version pins that
      turned out to matter.
    </p>

    <ul class="mt-14 space-y-3">
      {pages.map((page, i) => (
        <li class="reveal" style={`transition-delay: ${i * 50}ms`}>
          <a
            href={href(`wiki/${page.id}`)}
            class="block p-6 rounded-2xl border lift"
            style="border-color: var(--line); background: var(--surface)"
          >
            <h2 class="display text-xl" style="font-variation-settings: 'SOFT' 50, 'WONK' 1, 'opsz' 24">{page.data.title}</h2>
            <p class="mt-2 text-sm leading-relaxed" style="color: var(--muted)">{page.data.description}</p>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Base>
