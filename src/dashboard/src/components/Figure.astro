---
/**
 * One architecture figure as inline SVG.
 *
 * No diagram library ships to the browser: the figure is drawn at build time
 * from a list of boxes and arrows in data/figures.ts. Every colour is a theme
 * variable, so the same markup reads in light and dark. The frame scrolls
 * sideways on a narrow screen instead of shrinking the labels below reading
 * size, and the page itself never scrolls horizontally.
 */
import type { Figure, Side } from '../data/figures';

interface Props { figure: Figure; caption?: string }
const { figure, caption } = Astro.props as Props;

const byId = new Map(figure.nodes.map((n) => [n.id, n]));
const anchor = (id: string, side: Side) => {
  const n = byId.get(id);
  if (!n) throw new Error(`figure "${figure.id}": no node "${id}"`);
  if (side === 't') return [n.x + n.w / 2, n.y];
  if (side === 'b') return [n.x + n.w / 2, n.y + n.h];
  if (side === 'l') return [n.x, n.y + n.h / 2];
  return [n.x + n.w, n.y + n.h / 2];
};

const edges = figure.edges.map((e) => {
  const [x1, y1] = anchor(e.from, e.fromSide);
  const [x2, y2] = anchor(e.to, e.toSide);
  const vertical = e.fromSide === 't' || e.fromSide === 'b';
  // Straight when the ends line up, otherwise one right-angle bend.
  let d = `M${x1},${y1} L${x2},${y2}`;
  let lx = (x1 + x2) / 2;
  let ly = (y1 + y2) / 2;
  if (x1 !== x2 && y1 !== y2) {
    const sameAxis = vertical === (e.toSide === 't' || e.toSide === 'b');
    if (sameAxis && vertical) {
      const my = (y1 + y2) / 2;
      d = `M${x1},${y1} L${x1},${my} L${x2},${my} L${x2},${y2}`;
    } else if (sameAxis) {
      const mx = (x1 + x2) / 2;
      d = `M${x1},${y1} L${mx},${y1} L${mx},${y2} L${x2},${y2}`;
    } else if (vertical) {
      d = `M${x1},${y1} L${x1},${y2} L${x2},${y2}`;
      lx = (x1 + x2) / 2; ly = y2;
    } else {
      d = `M${x1},${y1} L${x2},${y1} L${x2},${y2}`;
      lx = (x1 + x2) / 2; ly = y1;
    }
  }
  return { ...e, d, lx: lx + (e.labelDx ?? 0), ly: ly + (e.labelDy ?? 0) };
});
const marker = `arrow-${figure.id}`;
---
<figure class="figure">
  <div class="figure-frame" tabindex="0" role="group" aria-label={`${figure.title}. Scrolls sideways on a narrow screen.`}>
    <svg
      viewBox={`0 0 ${figure.width} ${figure.height}`}
      width={figure.width}
      height={figure.height}
      role="img"
      aria-labelledby={`${figure.id}-title ${figure.id}-desc`}
    >
      <title id={`${figure.id}-title`}>{figure.title}</title>
      <desc id={`${figure.id}-desc`}>{figure.desc}</desc>
      <defs>
        <marker id={marker} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 z" fill="var(--ink)" />
        </marker>
      </defs>

      {figure.groups?.map((g) => (
        <g>
          <rect x={g.x} y={g.y} width={g.w} height={g.h} rx="14" class="figure-group" />
          <text x={g.x + 14} y={g.y + 22} class="figure-group-label">{g.label}</text>
        </g>
      ))}

      {edges.map((e) => (
        <path
          d={e.d}
          class:list={['figure-edge', { dashed: e.dashed }]}
          marker-end={`url(#${marker})`}
          marker-start={e.both ? `url(#${marker})` : undefined}
        />
      ))}

      {figure.nodes.map((n) => (
        <g>
          <rect x={n.x} y={n.y} width={n.w} height={n.h} rx="9" class:list={['figure-node', n.kind]} />
          <text x={n.x + n.w / 2} y={n.y + (n.sub ? 21 : n.h / 2 + 5)} text-anchor="middle" class:list={['figure-title', { mono: n.mono }]}>{n.title}</text>
          {n.sub?.map((line, i) => (
            <text x={n.x + n.w / 2} y={n.y + 38 + i * 15} text-anchor="middle" class="figure-sub">{line}</text>
          ))}
        </g>
      ))}

      {edges.filter((e) => e.label).map((e) => (
        <text x={e.lx} y={e.ly - 6} text-anchor="middle" class="figure-label">{e.label}</text>
      ))}
    </svg>
  </div>
  {caption && <figcaption class="mt-3 text-sm leading-relaxed max-w-2xl" style="color: var(--muted)">{caption}</figcaption>}
</figure>
