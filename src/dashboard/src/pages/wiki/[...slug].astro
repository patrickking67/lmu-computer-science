---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const pages = await getCollection('wiki');
  return pages.map((p) => ({ params: { slug: p.id }, props: { page: p } }));
}
const { page } = Astro.props;
const { Content } = await render(page);
const base = import.meta.env.BASE_URL;
---
<Base title={page.data.title} description={page.data.description}>
  <div class="mx-auto max-w-3xl px-4 sm:px-6 py-16">
    <a href={`${base}wiki`.replace(/\/+/g,'/')} class="text-sm hover:underline" style="color: var(--muted)">← Wiki</a>
    <article class="prose-custom mt-8"><Content /></article>
  </div>
</Base>

<style is:global>
  .prose-custom h1 { font-size: 2.25rem; font-weight: 600; letter-spacing: -0.02em; margin-bottom: 1.5rem; }
  .prose-custom h2 { font-size: 1.35rem; font-weight: 600; margin-top: 2.5rem; margin-bottom: 0.75rem; }
  .prose-custom h3 { font-size: 1.1rem; font-weight: 600; margin-top: 2rem; margin-bottom: 0.5rem; }
  .prose-custom p  { margin-bottom: 1.1rem; line-height: 1.75; color: var(--muted); }
  .prose-custom ul, .prose-custom ol { margin-bottom: 1.1rem; padding-left: 1.25rem; color: var(--muted); line-height: 1.75; }
  .prose-custom ul { list-style: disc; }
  .prose-custom ol { list-style: decimal; }
  .prose-custom li { margin-bottom: 0.35rem; }
  .prose-custom strong { color: var(--text); font-weight: 600; }
  .prose-custom a { color: var(--accent); text-decoration: underline; text-underline-offset: 2px; }
  .prose-custom code { font-family: var(--font-mono); font-size: 0.875em; background: var(--surface); border: 1px solid var(--border); padding: 0.1em 0.35em; border-radius: 4px; }
  .prose-custom pre { background: var(--surface); border: 1px solid var(--border); border-radius: 0.75rem; padding: 1rem 1.15rem; overflow-x: auto; margin-bottom: 1.5rem; }
  .prose-custom pre code { background: none; border: none; padding: 0; font-size: 0.85rem; }
  /* Wide tables scroll inside their own box; the page body never scrolls sideways. */
  .prose-custom table { width: 100%; border-collapse: collapse; margin-bottom: 1.5rem; font-size: 0.9rem; display: block; overflow-x: auto; }
  .prose-custom th, .prose-custom td { text-align: left; padding: 0.5rem 0.75rem; border-bottom: 1px solid var(--border); white-space: nowrap; }
  .prose-custom th { font-weight: 600; }
  .prose-custom td { color: var(--muted); }
</style>
