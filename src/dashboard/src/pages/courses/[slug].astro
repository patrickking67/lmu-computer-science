---
import Base from '../../layouts/Base.astro';
import { courses } from '../../data/courses';

export function getStaticPaths() {
  return courses.map((c) => ({ params: { slug: c.slug }, props: { course: c } }));
}
const { course } = Astro.props;
const b = import.meta.env.BASE_URL;
const u = (p: string) => `${b}/${p}`.replace(/\/+/g, '/');
const repo = `https://github.com/patrickking67/lmu-computer-science/tree/main/src/courses/${course.slug}`;
---
<Base title={course.code} description={course.blurb}>
  <div class="mx-auto max-w-3xl px-4 sm:px-6 py-16">
    <a href={u('courses')} class="text-sm hover:underline" style="color: var(--muted)">← All courses</a>
    <p class="eyebrow mt-8 settle">{course.code} · {course.term}</p>
    <h1 class="display text-[clamp(2rem,5vw,3.25rem)] mt-3 settle" style="animation-delay: 90ms">{course.title}</h1>
    <p class="mt-6 text-lg leading-relaxed settle" style="animation-delay: 170ms; color: var(--muted)">{course.blurb}</p>

    {course.stack.length > 0 && (
      <ul class="mt-8 flex flex-wrap gap-2 settle" style="animation-delay: 240ms">
        {course.stack.map((s) => (
          <li class="text-xs font-mono px-2.5 py-1 rounded-full" style="background: var(--raised); color: var(--ink)">{s}</li>
        ))}
      </ul>
    )}

    {course.work && (
      <div class="mt-10 p-6 rounded-2xl border lift" style="border-color: var(--line); background: var(--surface)">
        <p class="text-sm font-medium">In this repository</p>
        <p class="mt-1 text-sm" style="color: var(--muted)">{course.work}</p>
        <a href={repo} class="mt-4 inline-block text-sm hover:underline" style="color: var(--ink)">Browse the source →</a>
      </div>
    )}
  </div>
</Base>
