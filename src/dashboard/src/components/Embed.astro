---
/**
 * One running program, embedded.
 *
 * `inline` reads the program's own files at build time and hands them to a
 * sandboxed iframe as srcdoc; nothing is copied into the repository and the
 * source stays the single copy. `playground` bundles a program's own compiler
 * and runs it here. `external` sends you to a tab that can do what this page
 * cannot; see the comment on the URL below for why.
 */
import { readRepoText, readRepoDataUri } from '../lib/repo';
import Playground from './Playground.astro';
import type { Program } from '../data/programs';

interface Props { program: Program }
const { program } = Astro.props as Props;

/**
 * Compose the calculator into one self-contained document.
 *
 * The image rewrite is the only edit: index.html asks for interest.jpg where
 * the committed file is Interest.jpeg. That mismatch is a real defect in the
 * submitted work and stays in the coursework; fixing it here would make the
 * embed a lie in the other direction, so the page says what it did.
 */
function inlineDocument(dir: string): string {
  const css = readRepoText(`${dir}/cic.css`);
  const js = readRepoText(`${dir}/cic.js`);
  const image = readRepoDataUri(`${dir}/Interest.jpeg`, 'image/jpeg');
  return readRepoText(`${dir}/index.html`)
    .replace('<link rel="stylesheet" href="cic.css" />', `<style>\n${css}\n</style>`)
    .replace('<script src="cic.js"></script>', `<script>\n${js}\n</script>`)
    .replace('src="interest.jpg"', `src="${image}"`);
}

const srcdoc = program.embed === 'inline' ? inlineDocument(program.path) : '';

// A new tab, not an iframe. WebContainers need the embedding document to be
// cross-origin isolated; GitHub Pages cannot set headers, and StackBlitz's own
// embed page loads third-party resources without CORP, so even hosts that can
// set them hit the same error. Opening in a tab is StackBlitz's documented
// workaround and works everywhere.
const external = program.repo
  ? `https://stackblitz.com/github/${program.repo}` +
    (program.file ? `?file=${encodeURIComponent(program.file)}` : '')
  : '';
const repoName = program.repo?.split('/')[1] ?? program.name;
---
{program.embed === 'inline' && (
  <div class="rounded-2xl overflow-hidden border" style="border-color: var(--line); background: var(--surface)">
    <iframe
      title={`${program.name}, running`}
      srcdoc={srcdoc}
      sandbox="allow-scripts"
      loading="lazy"
      class="w-full block"
      style="height: 30rem; border: 0; background: #fff"
    ></iframe>
  </div>
)}

{program.embed === 'playground' && <Playground />}

{program.embed === 'external' && (
  <div class="rounded-2xl border grid place-items-center text-center px-6 py-14"
       style="border-color: var(--line); background: var(--surface)">
    <div class="space-y-3 max-w-sm">
      <p class="eyebrow">StackBlitz · new tab</p>
      <p class="text-sm leading-relaxed" style="color: var(--muted)">
        Installs and serves <span class="font-mono text-[0.95em]">{repoName}</span> in a
        WebContainer, still with nothing on your machine. It opens in its own tab because a
        WebContainer needs isolation headers this site cannot send.
      </p>
      <a
        href={external}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-1 inline-block px-5 py-2.5 rounded-full text-sm font-medium lift"
        style="background: var(--ink); color: var(--paper)"
      >Open and run it →</a>
    </div>
  </div>
)}
