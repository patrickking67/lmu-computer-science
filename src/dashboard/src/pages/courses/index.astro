---
import Base from '../../layouts/Base.astro';
import { courses } from '../../data/courses';
import { href } from '../../lib/site';

// Grouped by calendar year of the term, which is how anyone reading a
// transcript actually scans it.
const byYear = new Map<string, typeof courses>();
for (const course of courses) {
  const year = course.term.match(/\d{4}/)![0];
  byYear.set(year, [...(byYear.get(year) ?? []), course]);
}
const years = [...byYear.keys()].sort();
const withCode = courses.filter((c) => c.work).length;
---
<Base title="Courses" description="Fifteen CMSI courses at Loyola Marymount University, Fall 2021 to Spring 2025.">
  <div class="mx-auto max-w-4xl px-4 sm:px-6 py-20">
    <p class="eyebrow settle">{courses.length} courses · {withCode} produced code</p>
    <h1 class="display text-[clamp(2.25rem,5.5vw,3.5rem)] mt-4 settle" style="animation-delay: 100ms">Courses.</h1>
    <p class="mt-6 max-w-xl text-lg leading-relaxed settle" style="animation-delay: 180ms; color: var(--muted)">
      In the order I took them. Fifteen courses, thirteen repositories: CMSI 1900
      was a zero-unit seminar and CMSI 3920 a summer session, and neither left
      anything behind but a note.
    </p>

    {years.map((year, y) => (
      <section class="mt-14 reveal" style={`transition-delay: ${y * 50}ms`}>
        <h2 class="eyebrow pb-3 border-b" style="border-color: var(--line)">{year}</h2>
        <ul class="divide-y" style="border-color: var(--line-soft)">
          {byYear.get(year)!.map((c) => (
            <li>
              <a
                href={href(`courses/${c.slug}`)}
                class="flex flex-wrap items-baseline gap-x-4 gap-y-1 py-4 transition-opacity hover:opacity-70"
              >
                <span class="font-mono text-sm w-[5.5rem] shrink-0" style="color: var(--muted)">{c.code}</span>
                <span class="flex-1 min-w-[14rem] font-medium">{c.title}</span>
                <span class="text-sm" style="color: var(--faint)">{c.work ?? c.term}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>
