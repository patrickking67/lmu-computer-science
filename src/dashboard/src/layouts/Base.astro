---
import '../styles/global.css';
import Wordmark from '../components/Wordmark.astro';
import { href, isCurrent, site } from '../lib/site';

interface Props {
  title?: string | null;
  description?: string;
}
const {
  title,
  description = 'Computer science at Loyola Marymount University, Fall 2021 to Spring 2025. A compiler, a network stack, and thirteen languages, with the programs running on the page.',
} = Astro.props as Props;

const nav = [
  { path: 'programs', label: 'Programs' },
  { path: 'courses', label: 'Courses' },
  { path: 'wiki', label: 'Wiki' },
  { path: 'contact', label: 'Contact' },
];
const here = Astro.url.pathname;

// og:image has to be absolute -- a crawler resolves it against nothing. Astro.site
// is the deploy origin and href() adds the base path, so this is correct at both a
// user-site root and a project-site subpath, the same two cases astro.config.mjs
// exists to cover.
const cardUrl = new URL(href('social-preview.png'), Astro.site).href;
const pageUrl = new URL(here, Astro.site).href;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.owner}`;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.owner} />
    <link rel="canonical" href={pageUrl} />
    {/* Shared links had no card at all, so every paste of this site rendered as a
        bare URL. The image is a static asset in public/ rather than a generated
        route: it changes about as often as the wordmark does. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={cardUrl} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={cardUrl} />
    <meta name="twitter:image:alt" content={`${site.name}: coursework and running programs from ${site.years}`} />
    <meta property="og:image:alt" content={`${site.name}: coursework and running programs from ${site.years}`} />
    {/* Deliberately narrow. A script-src directive cannot go here: a sandboxed
        srcdoc iframe inherits this policy, the inline embed and the playground's
        Run stage both execute inline script inside one, and the playground's
        script is generated at runtime from what the visitor typed, so no
        build-time hash covers it and static hosting has no nonce. Adding
        'unsafe-inline' to buy back those two features would leave a script-src
        that permits exactly what script-src exists to stop. These three cost
        nothing and are not theatre: base-uri blocks a <base> injection that
        would silently repoint every relative URL on the page. frame-ancestors
        is not honoured in a meta tag, so clickjacking cover still needs a real
        header, which GitHub Pages will not send. */}
    <meta
      http-equiv="Content-Security-Policy"
      content="object-src 'none'; base-uri 'self'; form-action 'self'"
    />
    <link rel="icon" href={href('favicon.svg')} type="image/svg+xml" />
    {/* Browser chrome follows the page. These two cover the system case and the
        no-JS case; the scripts below overwrite both when an explicit theme is
        chosen, so whichever one matches is right either way. Values are --paper
        converted to sRGB. */}
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fafafa" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0c0c0c" />
    <link rel="sitemap" href={href('sitemap-index.xml')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT,WONK@9..144,300..700,0..100,0..1&family=Karla:wght@300..700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // Before first paint, so a stored preference never flashes the other theme.
      window.__paintChrome = (theme) => {
        const c = theme === 'dark' ? '#0c0c0c' : '#fafafa';
        for (const m of document.querySelectorAll('meta[name="theme-color"]')) m.content = c;
      };
      try {
        const stored = localStorage.getItem('theme');
        if (stored) {
          document.documentElement.dataset.theme = stored;
          window.__paintChrome(stored);
        }
      } catch (e) { /* private mode: fall through to prefers-color-scheme */ }
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:px-4 focus:py-2 focus:rounded-lg"
      style="background: var(--surface)"
    >Skip to content</a>

    <header
      class="sticky top-0 z-40 border-b backdrop-blur-md"
      style="border-color: var(--line); background: color-mix(in oklch, var(--paper) 82%, transparent)"
    >
      <nav class="mx-auto max-w-5xl px-4 sm:px-6 h-16 flex items-center gap-4 sm:gap-7" aria-label="Main">
        <a href={href()} class="shrink-0 text-lg" aria-label={`${site.name}, home`}>
          <Wordmark size={24} />
        </a>

        <ul class="flex items-center gap-3.5 sm:gap-5 text-sm min-w-0 overflow-x-auto no-scrollbar">
          {nav.map((item) => {
            const current = isCurrent(here, item.path);
            return (
              <li class="shrink-0">
                <a
                  href={href(item.path)}
                  aria-current={current ? 'page' : undefined}
                  class="transition-opacity hover:opacity-60"
                  style={current ? 'color: var(--ink)' : 'color: var(--muted)'}
                >{item.label}</a>
              </li>
            );
          })}
        </ul>

        <button
          id="theme"
          type="button"
          class="ml-auto shrink-0 w-8 h-8 rounded-full border grid place-items-center text-xs transition-colors"
          style="border-color: var(--line); color: var(--muted)"
          aria-label="Switch between light and dark"
        ><span aria-hidden="true">◐</span></button>
      </nav>
    </header>

    <main id="main" class="flex-1"><slot /></main>

    <footer class="border-t mt-28" style="border-color: var(--line)">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 py-12 text-sm space-y-3" style="color: var(--muted)">
        <p>{site.owner}, BS Computer Science, Loyola Marymount University, {site.years}.</p>
        <p>Advised by <strong style="color: var(--ink)">{site.advisor}</strong>, who taught most of what is in here.</p>
        <p class="flex flex-wrap gap-5 pt-2">
          <a href={site.github} class="hover:underline">GitHub</a>
          <a href={site.linkedin} class="hover:underline">LinkedIn</a>
          <a href={site.repo} class="hover:underline">This repository</a>
        </p>
      </div>
    </footer>

    <script is:inline>
      const toggle = document.getElementById('theme');
      const current = () => document.documentElement.dataset.theme
        || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');

      // The label carries the state as well as the action. Activating a control
      // called only "Switch between light and dark" announces nothing about what
      // happened, so a screen reader user cannot tell whether it worked.
      const label = (theme) => {
        if (toggle) toggle.setAttribute('aria-label', theme === 'dark'
          ? 'Theme: dark. Switch to light.'
          : 'Theme: light. Switch to dark.');
      };
      label(current());

      toggle?.addEventListener('click', () => {
        const next = current() === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        window.__paintChrome?.(next);
        label(next);
        try { localStorage.setItem('theme', next); } catch (e) { /* nothing to persist to */ }
      });
    </script>
  </body>
</html>
