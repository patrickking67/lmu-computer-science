---
import Base from '../layouts/Base.astro';
import Embed from '../components/Embed.astro';
import Tags from '../components/Tags.astro';
import { programs } from '../data/programs';
import { href, treeInRepo } from '../lib/site';

const runnable = programs.filter((p) => p.embed !== 'source');
const rest = programs.filter((p) => p.embed === 'source');
const inPage = programs.filter((p) => p.embed === 'inline' || p.embed === 'playground').length;

const badge: Record<string, string> = {
  inline: 'Runs in the page',
  playground: 'Runs in the page',
  external: 'Runs in a new tab',
};
---
<Base
  title="Programs"
  description="Programs from the coursework, running in the page. Nothing to clone, nothing to install."
>
  <div class="mx-auto max-w-4xl px-4 sm:px-6 py-20">
    <p class="eyebrow settle">{inPage} in the page · {runnable.length - inPage} in a tab · {rest.length} by source</p>
    <h1 class="display text-[clamp(2.25rem,5.5vw,3.5rem)] mt-4 settle" style="animation-delay: 100ms">Programs.</h1>
    <p class="mt-6 max-w-xl text-lg leading-relaxed settle" style="animation-delay: 180ms; color: var(--muted)">
      A calculator that runs inline, and a compiler that runs on your own input.
      One more opens in its own tab, because the thing that boots it needs headers
      this site cannot send. The rest want a native toolchain or credentials that
      are nobody else's business, and say so rather than pretending.
    </p>

    <ul class="mt-16 space-y-16">
      {runnable.map((p, i) => (
        <li class="reveal" style={`transition-delay: ${i * 60}ms`}>
          <div class="flex flex-wrap items-baseline gap-x-4 gap-y-2">
            <h2 class="display text-2xl" style="font-variation-settings: 'SOFT' 50, 'WONK' 1, 'opsz' 28">{p.name}</h2>
            <a href={href(`courses/${p.course.toLowerCase().replace(' ', '-')}`)} class="eyebrow hover:underline">{p.course}</a>
            <span class="ml-auto text-[11px] px-2.5 py-1 rounded-full border" style="border-color: var(--ink); color: var(--ink)">
              {badge[p.embed]}
            </span>
          </div>

          <p class="mt-4 leading-relaxed max-w-2xl" style="color: var(--muted)">{p.blurb}</p>
          <Tags items={p.stack} class="mt-4" />

          <div class="mt-6"><Embed program={p} /></div>

          {p.note && <p class="mt-3 text-sm leading-relaxed max-w-2xl" style="color: var(--muted)">{p.note}</p>}
          <div class="mt-2 flex flex-wrap gap-5 text-sm">
            {p.source && <a href={p.source} class="hover:underline" style="color: var(--ink)">Repository →</a>}
            <a href={treeInRepo(p.path)} class="hover:underline" style="color: var(--muted)">Source in this tree →</a>
          </div>
        </li>
      ))}
    </ul>

    <hr class="rule mt-24" />

    <h2 class="display text-2xl mt-14 reveal" style="font-variation-settings: 'SOFT' 50, 'WONK' 1, 'opsz' 28">
      Read instead of run.
    </h2>
    <p class="mt-3 max-w-xl leading-relaxed reveal" style="color: var(--muted)">
      Compiled languages, raw sockets, and projects wired to a live account. A
      browser tab cannot host any of them honestly, so here they are as source.
    </p>

    <ul class="mt-10 space-y-4">
      {rest.map((p, i) => (
        <li
          class="reveal p-6 rounded-2xl border lift"
          style={`border-color: var(--line); background: var(--surface); transition-delay: ${i * 40}ms`}
        >
          <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
            <h3 class="display text-xl" style="font-variation-settings: 'SOFT' 50, 'WONK' 1, 'opsz' 24">{p.name}</h3>
            <a href={href(`courses/${p.course.toLowerCase().replace(' ', '-')}`)} class="eyebrow hover:underline">{p.course}</a>
          </div>
          <p class="mt-3 leading-relaxed max-w-2xl" style="color: var(--muted)">{p.blurb}</p>
          <Tags items={p.stack} class="mt-4" />
          {p.note && <p class="mt-3 text-sm" style="color: var(--muted)">{p.note}</p>}
          <a href={treeInRepo(p.path)} class="mt-3 inline-block text-sm hover:underline" style="color: var(--ink)">Source →</a>
        </li>
      ))}
    </ul>
  </div>
</Base>
