# Normalise line endings for maintained files.
* text=auto eol=lf

# Coursework is kept exactly as submitted, line endings included. Five files
# under src/courses/cmsi-3300 were committed with CRLF; normalising them would
# rewrite submitted work. See AGENTS.md.
src/courses/** -text

# GitHub's language bar. CloudScribe example programs end in .csc, which
# linguist reads as GSC, a Call of Duty scripting language. They are CloudScribe
# source and no GitHub language, so count them as plain text. The two .rtf files
# are instructor grading notes, not code.
*.csc linguist-language=Text
*.rtf linguist-documentation

# Binary assets.
*.png binary
*.PNG binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.docx binary
*.woff binary
*.woff2 binary
*.bundle binary
