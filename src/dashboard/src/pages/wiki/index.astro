---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const base = import.meta.env.BASE_URL;
const pages = (await getCollection('wiki')).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Wiki" description="Notes on how the projects work and how to run them.">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 py-16">
    <h1 class="text-4xl font-semibold tracking-tight">Wiki</h1>
    <p class="mt-3" style="color: var(--muted)">How things are built, and what it took to make them work.</p>
    <ul class="mt-10 space-y-3">
      {pages.map((p) => (
        <li>
          <a href={`${base}wiki/${p.id}`.replace(/\/+/g,'/')} class="block p-5 rounded-xl border transition-opacity hover:opacity-80" style="border-color: var(--line); background: var(--surface)">
            <h2 class="font-medium">{p.data.title}</h2>
            <p class="mt-1 text-sm" style="color: var(--muted)">{p.data.description}</p>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Base>
