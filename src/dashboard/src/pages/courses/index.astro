---
import Base from '../../layouts/Base.astro';
import { courses } from '../../data/courses';
const base = import.meta.env.BASE_URL;
const byYear = courses.reduce((acc, c) => {
  const y = c.term.match(/\d{4}/)![0];
  (acc[y] ||= []).push(c);
  return acc;
}, {} as Record<string, typeof courses>);
const years = Object.keys(byYear).sort();
---
<Base title="Courses" description="Fifteen CMSI courses at Loyola Marymount University, 2021 to 2025.">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 py-16">
    <h1 class="text-4xl font-semibold tracking-tight">Courses</h1>
    <p class="mt-3 max-w-2xl" style="color: var(--muted)">
      Fifteen courses across four years, in the order I took them.
    </p>

    {years.map((y) => (
      <section class="mt-12">
        <h2 class="font-mono text-sm mb-4 pb-2 border-b" style="color: var(--ink); border-color: var(--line)">{y}</h2>
        <ul class="divide-y" style="border-color: var(--line)">
          {byYear[y].map((c) => (
            <li>
              <a href={`${base}courses/${c.slug}`.replace(/\/+/g,'/')} class="flex flex-wrap items-baseline gap-x-4 gap-y-1 py-4 hover:opacity-75 transition-opacity">
                <span class="font-mono text-sm w-24 shrink-0" style="color: var(--ink)">{c.code}</span>
                <span class="font-medium flex-1 min-w-[16rem]">{c.title}</span>
                <span class="text-sm" style="color: var(--muted)">{c.work ?? ''}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>
